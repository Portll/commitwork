{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/owner-map.schema.json",
  "title": "Repository owner map",
  "type": "object",
  "required": ["$comment", "$scope", "$defaults", "$notConsumed", "repos", "infra"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string", "minLength": 1 },
    "$scope": { "type": "object" },
    "$defaults": { "type": "object" },
    "$notConsumed": { "type": "object" },
    "repos": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["team", "technology"],
        "additionalProperties": false,
        "properties": {
          "team": { "type": "string", "minLength": 1 },
          "technology": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "infra": { "type": ["object", "null"] }
  }
}
