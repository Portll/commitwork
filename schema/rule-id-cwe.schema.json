{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/rule-id-cwe.schema.json",
  "title": "Scanner rule to CWE map",
  "type": "object",
  "required": ["$comment", "semgrep", "codeql", "spotbugs", "eslint", "internal"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string", "minLength": 1 },
    "semgrep": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } } },
    "codeql": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } } },
    "spotbugs": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } } },
    "eslint": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } } },
    "internal": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } } },
    "cobolwork": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } } }
  }
}
