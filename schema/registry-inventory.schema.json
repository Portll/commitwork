{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registry inventory",
  "description": "Classifies tracked JSON data and records its schema binding.",
  "type": "object",
  "required": [
    "note",
    "kinds",
    "bindings",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "kinds": {
      "type": "object",
      "required": [
        "declaration",
        "store",
        "feed"
      ],
      "additionalProperties": false,
      "properties": {
        "declaration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "store": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "feed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "bindings": {
      "type": "object",
      "required": [
        "validator",
        "mirrored",
        "none"
      ],
      "additionalProperties": false,
      "properties": {
        "validator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mirrored": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "none": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "finding",
          "found",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "found": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "schema"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "declaration",
              "store",
              "feed"
            ]
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "binding": {
            "enum": [
              "validator",
              "mirrored",
              "none"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 240
          },
          "note": {
            "type": "string",
            "description": "Brief transition history; reason explains the current classification.",
            "maxLength": 240
          }
        }
      }
    }
  }
}
