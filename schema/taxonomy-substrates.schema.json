{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/taxonomy-substrates.schema.json",
  "title": "Failure taxonomy substrate map",
  "type": "object",
  "required": ["version", "generatedFrom", "note", "substrates", "tiers", "map", "mapVerifiedAgainst"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generatedFrom": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "substrates": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "tiers": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "map": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z]+[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["substrate", "tier", "predicate"],
        "additionalProperties": false,
        "properties": {
          "substrate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "tier": { "type": "string", "pattern": "^T[1-4]$" },
          "scope": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mapVerifiedAgainst": {
      "type": "object",
      "required": ["at", "registryClasses", "mapped", "unmapped", "note"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string", "minLength": 1 },
        "registryVersion": { "type": "integer", "minimum": 1, "$comment": "Which registry edition these counts were derived against. Not required: the counts are re-derived by bin/test/taxonomy-registry-coverage.test.mjs and stand without it, but a coverage figure that cannot say which edition it measured is a number with no population — the defect this map catalogues as M18." },
        "registryClasses": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "unmapped": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
