{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daily remediation report",
  "description": "The stored report for one batch of one area: the model's commitwork.daily-suggestions/1 output, validated, inside an envelope bin/daily-run.mjs computes from the digest (counts, coverage, provenance, run record). Report mode: suggestions are text for a person or session, never edits. Kept 90 days; the digest beside it 14.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "area",
    "batch",
    "previousBatch",
    "digestId",
    "generatedAt",
    "summary",
    "coverage",
    "run",
    "headline",
    "suggestions",
    "notActioned"
  ],
  "properties": {
    "schema": {
      "const": "commitwork.daily-report/1"
    },
    "area": {
      "type": "string"
    },
    "batch": {
      "type": "string",
      "pattern": "^sweep-[0-9]{14}$"
    },
    "previousBatch": {
      "type": [
        "string",
        "null"
      ]
    },
    "digestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generatedAt": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new",
        "persisting",
        "fixed",
        "carried",
        "omitted",
        "voidLanes",
        "gapDays",
        "baselineRepos"
      ],
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "persisting": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "carried": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "voidLanes": {
          "type": "integer",
          "minimum": 0
        },
        "gapDays": {
          "type": [
            "number",
            "null"
          ]
        },
        "baselineRepos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "lane",
          "state"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "state": {
            "enum": [
              "void",
              "failed",
              "skipped",
              "timed-out",
              "tool-changed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "cli",
        "attempts",
        "costUsd",
        "durationMs",
        "authority",
        "skillSha256"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "cli": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "durationMs": {
          "type": "integer"
        },
        "authority": {
          "type": "string",
          "description": "What allows this automated spend while the remediation policy's budget is 0: report mode, no edits."
        },
        "skillSha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "sha256 of the skill text the model ran under; null when the suggestions came from a file."
        }
      }
    },
    "headline": {
      "type": "string"
    },
    "suggestions": {
      "type": "array"
    },
    "notActioned": {
      "type": "array"
    },
    "advice": {
      "type": "array",
      "description": "Per repo whose cobolwork lane ran, computed from the digest: the suggestion list cobolwork's advice document gives, in its order, or why there was no advice and the suggestions were written from the scanner's rule text.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "state",
              "reason"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "state": {
                "const": "unavailable"
              },
              "reason": {
                "type": "string",
                "maxLength": 600
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "state",
              "toolVersion",
              "unmeasured",
              "omitted",
              "dataPathItems",
              "suggestions"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "state": {
                "const": "read"
              },
              "toolVersion": {
                "type": "string"
              },
              "unmeasured": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "omitted": {
                "type": "integer",
                "minimum": 0
              },
              "dataPathItems": {
                "type": "integer",
                "minimum": 0
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind",
                    "ref",
                    "sev",
                    "verdict",
                    "where",
                    "detail",
                    "text",
                    "steps",
                    "fixAt",
                    "compliance",
                    "findingIds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The advice item id, as cobolwork-advice writes it."
                    },
                    "kind": {
                      "enum": [
                        "finding",
                        "practice",
                        "compile",
                        "option",
                        "inventory"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "description": "The rule, practice or ironwork message id the item rests on."
                    },
                    "sev": {
                      "enum": [
                        "info",
                        "low",
                        "med",
                        "high",
                        "crit"
                      ]
                    },
                    "verdict": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "where": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "line",
                        "program",
                        "item"
                      ],
                      "properties": {
                        "path": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "line": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "program": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "item": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "fingerprint": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{32}$"
                    },
                    "detail": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "text": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 600,
                      "description": "remediation.text: what to do."
                    },
                    "steps": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "fixAt": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "line",
                        "item",
                        "test"
                      ],
                      "description": "remediation.fixAt: where the change goes and the test to place there; test is null where no test makes it safe, and why says so.",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "line": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "item": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "test": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 600
                        },
                        "why": {
                          "type": "string",
                          "maxLength": 300
                        }
                      }
                    },
                    "compliance": {
                      "type": "array",
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "framework",
                          "clause"
                        ],
                        "properties": {
                          "framework": {
                            "type": "string"
                          },
                          "clause": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "findingIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{16}$"
                      },
                      "description": "The items of this repo the entry covers; empty for a practice, compile, option or inventory item, which no lane reports."
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
