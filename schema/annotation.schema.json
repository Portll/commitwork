{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commitwork.local/schema/annotation.schema.json",
  "title": "commitwork annotation store",
  "description": "Human judgments over findings, applied AS-OF each slice's generated time. The `determination` object does NOT replace `action`, which is the lifecycle verdict; it records the STRUCTURED REASON behind it, which prose in `reason` carries in a form nothing can read.",
  "type": "object",
  "required": ["annotations"],
  "properties": {
    "_comment": { "type": "string" },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "required": ["action", "reason", "who", "at"],
      "properties": {
        "id": { "type": "string", "description": "Advisory id. Omitted = wildcard." },
        "package": { "type": "string", "description": "Omitted = wildcard." },
        "repo": { "type": "string", "description": "Omitted = wildcard, which once suppressed a CVE fleet-wide (see the store's own comment). Prefer naming it." },
        "action": { "type": "string", "enum": ["accept", "wont-fix", "false-positive", "resolved", "note", "incorrect-scan-result"] },
        "reason": { "type": "string", "minLength": 1 },
        "who": { "type": "string", "minLength": 1 },
        "at": { "type": "string" },
        "expires": { "type": "string" },
        "determination": { "$ref": "#/$defs/determination" }
      }
    },
    "determination": {
      "type": "object",
      "additionalProperties": false,
      "description": "The structured why. Axes are INDEPENDENT and all optional — an operator states what they actually determined and nothing else. An axis left out is `unknown`, which is a real state and never an absence. Values are validated against cra/determination.mjs, and a reachability or exploitability claim is REFUSED without evidence carrying a matching method (the evidence gate).",
      "properties": {
        "presence": { "type": "string", "enum": ["component_absent", "component_present_code_absent", "component_present_code_present"] },
        "reachability": { "type": "string", "enum": ["unreachable_static", "unreachable_config", "unreachable_dependency", "unreachable_environment", "reachable", "reachability_unproven", "reachability_unknown"] },
        "exploitability": { "type": "string", "enum": ["adversary_cannot_control", "mitigated_inline", "mitigated_compiler", "mitigated_runtime", "mitigated_perimeter", "exploitable", "exploitability_unknown"] },
        "remediation": { "type": "string", "enum": ["fixed_verified", "fix_available_not_applied", "fix_planned", "no_fix_available_upstream", "will_not_fix_by_choice", "workaround_applied", "mitigation_applied", "rollback_applied", "under_investigation"] },
        "evidence": {
          "type": "array",
          "description": "What supports the claim. Without a matching method the reachability/exploitability axes degrade to unknown rather than being published.",
          "items": {
            "type": "object",
            "required": ["method"],
            "properties": {
              "source": { "type": "string" },
              "method": { "type": "string", "enum": ["call_graph", "config_read", "manual_review", "vendor_statement", "dual_agent_adjudication", "scanner_default"] },
              "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
              "detail": { "type": "string" },
              "at": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
