{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portll/commitwork/release-terms.schema.json",
  "title": "commitwork denied-term list for release candidates",
  "description": "Terms a published tree must not carry. Applied at read time by loadTerms() in bin/lib/release-terms.mjs: an invalid list refuses to load, and the release gate reports cannot-check rather than clean. The real list is private; monitor/release-terms.example.json shows the shape.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "why": { "type": "string", "minLength": 3 },
          "words": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "caseSensitive": { "type": "boolean" },
          "exceptPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "$comment": { "type": "string" }
        }
      }
    }
  }
}
