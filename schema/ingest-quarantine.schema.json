{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/ingest-quarantine.schema.json",
  "title": "Ingest quarantine",
  "type": "object",
  "required": ["note", "version", "dropped", "entries"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "dropped": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "channel", "who", "refused", "errors", "payloadSha", "payloadTruncated", "payload"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "who": { "type": ["string", "null"] },
          "refused": { "type": "string", "minLength": 1 },
          "errors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "payloadSha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "payloadTruncated": { "type": "boolean" },
          "payload": { "type": "string" }
        }
      }
    }
  }
}
