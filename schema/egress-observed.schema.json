{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commitwork.online/schema/egress-observed.schema.json",
  "title": "Egress observations of a run",
  "description": "<report dir>/egress-observed.json, appended by recordObservation() in bin/lib/egress-observe.mjs: one row per networked lane the runner (bin/commitwork.mjs) ran under CW_EGRESS_OBSERVE, read by monitor/egress-suggest.mjs. A row is the lane's ledger, the stand-in for a ledger that could not be read, or an unobserved lane with its reason. The last two carry destinations null, never an empty list.",
  "$comment": "Applied by bin/test/egress-observe.test.mjs to a live run's file. lib/json-schema.mjs has no $ref, so the common fields repeat in each branch and the destination row repeats schema/egress-ledger.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lanes"],
  "properties": {
    "unreadablePrevious": { "const": true, "description": "The file this run appended to did not parse or had no lanes array, and was started again." },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "title": "Observed lane",
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "egress", "repo", "at", "lane", "mode", "coverage", "denyPrivate", "destinations"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "egress": { "type": "string", "pattern": "^(?!none$)[a-z][a-z-]*$", "description": "The check's declared egress class; a lane declared none is never observed." },
              "repo": { "type": "string", "description": "Basename of the scanned checkout." },
              "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "description": "lib/clock.mjs nowISO(), which honours CW_NOW." },
              "lane": { "type": ["string", "null"], "minLength": 1 },
              "mode": { "enum": ["observe", "enforce"] },
              "coverage": { "const": "proxy-honouring clients only" },
              "denyPrivate": { "type": "boolean" },
              "destinations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host", "port", "allowed", "denied", "local"],
                  "properties": {
                    "host": { "type": "string", "minLength": 1, "pattern": "^[^A-Z]+$" },
                    "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
                    "allowed": { "type": "integer", "minimum": 0 },
                    "denied": { "type": "integer", "minimum": 0 },
                    "local": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "title": "Ledger not read",
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "egress", "repo", "at", "mode", "coverage", "destinations", "why"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "egress": { "type": "string", "pattern": "^(?!none$)[a-z][a-z-]*$" },
              "repo": { "type": "string" },
              "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
              "mode": { "enum": ["observe", "enforce"] },
              "coverage": { "const": "proxy-honouring clients only" },
              "destinations": { "type": "null" },
              "why": { "type": "string", "pattern": "^ledger not written \\(" }
            }
          },
          {
            "title": "Unobserved lane",
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "egress", "repo", "at", "mode", "destinations", "unobserved"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "egress": { "type": "string", "pattern": "^(?!none$)[a-z][a-z-]*$" },
              "repo": { "type": "string" },
              "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
              "mode": { "const": "observe", "description": "Enforce refuses a lane it cannot observe rather than recording it." },
              "destinations": { "type": "null" },
              "unobserved": { "type": "string", "minLength": 1, "description": "Why the proxy could not see the lane: an upstream proxy it does not chain to, or a containerised command." }
            }
          }
        ]
      }
    }
  }
}
