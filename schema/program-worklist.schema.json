{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/program-worklist.schema.json",
  "title": "Program worklist",
  "type": "object",
  "required": ["note", "programs"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string", "minLength": 1 },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "items"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1, "description": "Area slug or label whose timeline renders this programme. Absent: the primary area only (monitor/timeline-scope.mjs)." },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "phase", "title", "deps", "status", "evidence"],
              "additionalProperties": false,
              "properties": {
                "_": { "type": "number" },
                "id": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "deps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "status": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
