{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/approach-taxonomy.schema.json",
  "title": "Scanner approach taxonomy",
  "type": "object",
  "required": ["title", "note", "types", "sourceKinds", "weaknessClassNote", "weaknessClassVocab", "oracleTiers", "approaches", "sourceNote"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 1 },
    "types": { "type": "object" }, "sourceKinds": { "type": "object" },
    "weaknessClassNote": { "type": "string" }, "weaknessClassVocab": { "type": "object" }, "oracleTiers": { "type": "object" },
    "approaches": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["check", "weaknessClasses", "oracleTier", "name", "type", "sourceKind", "findsSourceVulns", "escalates"], "properties": { "check": { "type": "string", "minLength": 1 }, "weaknessClasses": { "type": "array", "items": { "type": "string" } }, "oracleTier": { "type": "integer", "minimum": 1, "maximum": 3 }, "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "sourceKind": { "type": "string", "minLength": 1 }, "findsSourceVulns": { "type": "boolean" }, "escalates": { "type": "string" }, "note": { "type": "string" }, "ruleIds": { "type": "array", "items": { "type": "string" } }, "source": { "type": "object" } }, "additionalProperties": false } },
    "sourceNote": { "type": "string" }
  }
}
