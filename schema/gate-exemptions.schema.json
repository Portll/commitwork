{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/gate-exemptions.schema.json",
  "title": "Gate exemptions",
  "type": "object",
  "required": ["_comment", "exemptions"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "exemptions": { "type": "array", "items": { "type": "object", "required": ["gate", "service", "area", "action", "reason", "who", "at", "expires", "expiresReason"], "additionalProperties": false, "properties": { "gate": { "type": "string" }, "service": { "type": "string" }, "area": { "type": "string" }, "action": { "type": "string" }, "reason": { "type": "string", "minLength": 20 }, "who": { "type": "string" }, "at": { "type": "string" }, "expires": { "type": "string" }, "expiresReason": { "type": "string", "minLength": 1 } } } }
  }
}
