{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/disk-encryption.schema.json",
  "title": "Disk encryption baseline",
  "type": "object",
  "required": ["comment", "rationale", "appliesTo", "required", "outOfScope"],
  "additionalProperties": false,
  "properties": {
    "comment": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "appliesTo": { "type": "string", "minLength": 1 },
    "required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["volume", "why", "platforms", "recoveryNote"],
        "additionalProperties": false,
        "properties": {
          "volume": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "platforms": {
            "type": "object",
            "propertyNames": { "pattern": "^(darwin|linux|win32)$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "recoveryNote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
