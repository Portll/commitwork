{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/perf-profiles.schema.json",
  "title": "Scanner performance profiles",
  "type": "object",
  "required": ["version", "note", "measuredFrom", "diskClasses", "profiles", "costClasses", "scanners", "depthLevels", "intensityLevels"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string", "minLength": 1 },
    "measuredFrom": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "diskClasses": { "type": "object", "additionalProperties": { "type": "object", "required": ["label", "jobsMultiplier", "note"], "additionalProperties": false, "properties": { "label": { "type": "string", "minLength": 1 }, "jobsMultiplier": { "type": "number", "exclusiveMinimum": 0 }, "note": { "type": "string", "minLength": 1 } } } },
    "profiles": { "type": "object", "additionalProperties": { "type": "object", "required": ["id", "label", "vendor", "cores", "threads", "ramGB", "diskClass", "containers", "note"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "vendor": { "type": "string", "minLength": 1 }, "arch": { "type": "string", "minLength": 1 }, "cores": { "type": ["integer", "null"], "minimum": 1 }, "threads": { "type": ["integer", "null"], "minimum": 1 }, "ramGB": { "type": ["number", "null"], "exclusiveMinimum": 0 }, "diskClass": { "type": ["string", "null"] }, "containers": { "type": ["boolean", "null"] }, "note": { "type": "string", "minLength": 1 }, "modelMatch": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
    "costClasses": { "type": "object", "additionalProperties": { "type": "object", "required": ["coresPerRun", "ramGB", "timeoutMs", "minDepth", "note"], "additionalProperties": false, "properties": { "coresPerRun": { "type": "number", "exclusiveMinimum": 0 }, "ramGB": { "type": "number", "exclusiveMinimum": 0 }, "timeoutMs": { "type": "integer", "minimum": 1 }, "minDepth": { "type": "integer", "minimum": 1 }, "note": { "type": "string", "minLength": 1 } } } },
    "scanners": { "type": "object", "additionalProperties": { "type": "object", "required": ["cost", "container"], "additionalProperties": false, "properties": { "cost": { "type": "string", "minLength": 1 }, "container": { "type": "boolean" }, "note": { "type": "string", "minLength": 1 }, "minDepth": { "type": "integer", "minimum": 1 }, "needsToken": { "type": "string", "minLength": 1 }, "runtime": { "type": "boolean" }, "depthLadder": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": { "label": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 1 } } } }, "intensityLadder": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": { "label": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 1 } } } } } } },
    "outsideRunner": { "type": "object", "additionalProperties": { "type": "object", "required": ["what", "module", "runs", "tools"], "additionalProperties": false, "properties": { "what": { "type": "string", "minLength": 1 }, "module": { "type": "string", "minLength": 1 }, "runs": { "type": "string", "minLength": 1 }, "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "view": { "type": "string", "minLength": 1 } } } },
    "depthLevels": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["level", "label", "description"], "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1 }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } } },
    "intensityLevels": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["level", "label", "description"], "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1 }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } } }
  }
}
