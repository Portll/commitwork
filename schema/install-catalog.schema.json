{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commitwork.online/schema/install-catalog.schema.json",
  "title": "Scanner install catalogue",
  "description": "Hand-authored tool data for `commitwork setup` (bin/setup.mjs). Key order is print order. brew, winget, scoop, pipx, npm, apt and dnf carry a package id; cargo, gem, composer and go carry a whole command. A null id means the manager has no package. An idChecks record overrides the idChecksByManager record for one id.",
  "$comment": "No open format covers a per-tool map across brew, winget, scoop, pipx and command-string managers. No $ref: monitor/registry.mjs refuses it, so the id-check record is written out twice.",
  "type": "object",
  "required": ["tools"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string" },
    "idChecksByManager": {
      "type": "object",
      "propertyNames": { "pattern": "^(brew|winget|scoop|pipx|npm|apt|dnf|cargo|gem|composer|go|release)$" },
      "additionalProperties": {
        "type": "object",
        "required": ["state", "checkedAt", "how"],
        "additionalProperties": false,
        "properties": {
          "state": { "enum": ["resolves", "unresolved", "unprobed"] },
          "checkedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "how": { "type": "string", "minLength": 21 }
        }
      }
    },
    "tools": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["why"],
        "additionalProperties": false,
        "properties": {
          "why": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "manual": { "type": "boolean" },
          "brew": { "type": ["string", "null"], "minLength": 1 },
          "winget": { "type": ["string", "null"], "minLength": 1 },
          "scoop": { "type": ["string", "null"], "minLength": 1 },
          "pipx": { "type": "string", "minLength": 1 },
          "npm": { "type": "string", "minLength": 1 },
          "apt": { "type": "string", "minLength": 1 },
          "dnf": { "type": "string", "minLength": 1 },
          "cargo": { "type": "string", "minLength": 1 },
          "gem": { "type": "string", "minLength": 1 },
          "composer": { "type": "string", "minLength": 1 },
          "go": { "type": "string", "minLength": 1 },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["darwin", "linux", "win32"] }
          },
          "providedBy": { "type": "string", "minLength": 1 },
          "requiredBy": { "type": "string", "minLength": 1 },
          "postInstall": {
            "description": "A string is a note and never runs. An array holds argv arrays to run and string notes.",
            "type": ["string", "array"],
            "minLength": 1,
            "items": {
              "type": ["string", "array"],
              "minLength": 1,
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "steps": {
            "description": "Manual steps: a list, or an object keyed by the check id that reports the step absent.",
            "type": ["array", "object"],
            "items": { "type": "string", "minLength": 1 },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "ready": {
            "type": "object",
            "required": ["cmd", "expect"],
            "additionalProperties": false,
            "properties": {
              "cmd": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "expect": { "type": "string", "minLength": 1 },
              "why": { "type": "string" }
            }
          },
          "requiresAccount": {
            "type": "object",
            "required": ["vendor"],
            "additionalProperties": false,
            "properties": {
              "vendor": { "type": "string", "minLength": 1 },
              "needs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "freeTier": { "type": "string" },
              "why": { "type": "string" }
            }
          },
          "idChecks": {
            "type": "object",
            "propertyNames": { "pattern": "^(brew|winget|scoop|pipx|npm|apt|dnf|cargo|gem|composer|go)$" },
            "additionalProperties": {
              "type": "object",
              "required": ["state", "checkedAt", "how"],
              "additionalProperties": false,
              "properties": {
                "state": { "enum": ["resolves", "unresolved", "unprobed"] },
                "checkedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "how": { "type": "string", "minLength": 21 }
              }
            }
          },
          "release": {
            "description": "A pinned GitHub release asset per platform and arch. lib/release-signing.mjs refuses a cosign-checksums block missing checksums, identity or issuer.",
            "type": "object",
            "required": ["repo", "tag"],
            "additionalProperties": false,
            "properties": {
              "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "tag": { "type": "string", "minLength": 1 },
              "signing": {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["cosign-checksums", "none"] },
                  "checksums": { "type": "string", "minLength": 1 },
                  "identity": { "type": "string", "minLength": 1 },
                  "issuer": { "type": "string", "pattern": "^https://" },
                  "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "note": { "type": "string" }
                },
                "oneOf": [
                  { "properties": { "kind": { "const": "cosign-checksums" } }, "required": ["checksums", "identity", "issuer"] },
                  { "properties": { "kind": { "const": "none" } } }
                ]
              },
              "darwin": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x64": { "type": "object", "required": ["asset", "sha256"], "additionalProperties": false, "properties": { "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
                  "arm64": { "type": "object", "required": ["asset", "sha256"], "additionalProperties": false, "properties": { "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
                }
              },
              "linux": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x64": { "type": "object", "required": ["asset", "sha256"], "additionalProperties": false, "properties": { "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
                  "arm64": { "type": "object", "required": ["asset", "sha256"], "additionalProperties": false, "properties": { "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
                }
              },
              "win32": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x64": { "type": "object", "required": ["asset", "sha256"], "additionalProperties": false, "properties": { "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
                  "arm64": { "type": "object", "required": ["asset", "sha256"], "additionalProperties": false, "properties": { "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
                }
              }
            }
          }
        }
      }
    }
  }
}
