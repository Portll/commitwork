{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "properties": {
        "suppressedCount": 1
      },
      "tool": {
        "driver": {
          "name": "commitwork-deno-hazards",
          "informationUri": "https://commitwork.portll.net",
          "rules": [
            {
              "id": "deno/allow-all",
              "shortDescription": {
                "text": "All permissions granted (-A / --allow-all): the Deno sandbox is switched off for this program."
              }
            },
            {
              "id": "deno/allow-env-unscoped",
              "shortDescription": {
                "text": "--allow-env with no variable list: every environment variable, every secret in it, is readable."
              }
            },
            {
              "id": "deno/allow-ffi-unscoped",
              "shortDescription": {
                "text": "--allow-ffi with no path list: any native library can be loaded, and native code is outside the sandbox."
              }
            },
            {
              "id": "deno/allow-import-unscoped",
              "shortDescription": {
                "text": "--allow-import with no host list: code may be imported at run time from any host."
              }
            },
            {
              "id": "deno/allow-net-unscoped",
              "shortDescription": {
                "text": "--allow-net with no host list: the process may connect anywhere, including internal services and metadata endpoints."
              }
            },
            {
              "id": "deno/allow-read-unscoped",
              "shortDescription": {
                "text": "--allow-read with no path list: every file the user can read is readable, including keys and credentials."
              }
            },
            {
              "id": "deno/allow-run-shell",
              "shortDescription": {
                "text": "--allow-run names a shell or interpreter: running sh/bash/python/node with arguments is running any program."
              }
            },
            {
              "id": "deno/allow-run-unscoped",
              "shortDescription": {
                "text": "--allow-run with no program list: the process may execute any program, which escapes every other permission."
              }
            },
            {
              "id": "deno/allow-scripts-unscoped",
              "shortDescription": {
                "text": "--allow-scripts with no package list: every npm lifecycle script in the dependency tree runs on install."
              }
            },
            {
              "id": "deno/allow-write-unscoped",
              "shortDescription": {
                "text": "--allow-write with no path list: the process may overwrite any file the user can, including its own source."
              }
            },
            {
              "id": "deno/cleartext-import",
              "shortDescription": {
                "text": "A module is imported over http://: anyone on the network path can replace the code."
              }
            },
            {
              "id": "deno/ignore-certificate-errors",
              "shortDescription": {
                "text": "TLS certificate verification is disabled: every HTTPS connection, module downloads included, accepts a forged certificate."
              }
            },
            {
              "id": "deno/inspector-exposed",
              "shortDescription": {
                "text": "The V8 inspector listens on a non-loopback address: anyone who reaches the port can run arbitrary code in the process."
              }
            },
            {
              "id": "deno/lock-disabled",
              "shortDescription": {
                "text": "The lockfile is disabled: nothing verifies that remote modules are the ones that were reviewed."
              }
            },
            {
              "id": "deno/permission-set-unscoped",
              "shortDescription": {
                "text": "A permission set in deno.json grants an unscoped permission (true rather than a list)."
              }
            },
            {
              "id": "deno/remote-entrypoint",
              "shortDescription": {
                "text": "A remote URL is executed directly: whoever controls that URL decides what runs, with the permissions on the command line."
              }
            },
            {
              "id": "deno/unpinned-import",
              "shortDescription": {
                "text": "A remote module or registry specifier has no version: its publisher, or whoever takes over the name, can change the code that runs."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "deno/allow-all",
          "level": "warning",
          "message": {
            "text": "All permissions granted (-A / --allow-all): the Deno sandbox is switched off for this program. (deno run scripts/release.ts)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ]
        },
        {
          "ruleId": "deno/allow-all",
          "level": "note",
          "message": {
