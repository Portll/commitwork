{
 "version": "2.1.0",
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "commitwork-eol",
     "rules": [
      {
       "id": "eol/nodejs-16",
       "name": "eol/nodejs-16",
       "shortDescription": {
        "text": "Node.js 16 reached end of life on 2023-09-11"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "CWE-1104: Use of Unmaintained Third Party Components"
        ]
       }
      },
      {
       "id": "eol/postgresql-9.6",
       "name": "eol/postgresql-9.6",
       "shortDescription": {
        "text": "PostgreSQL 9.6 reached end of life on 2021-11-11"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "CWE-1104: Use of Unmaintained Third Party Components"
        ]
       }
      },
      {
       "id": "eol/ruby-2.7",
       "name": "eol/ruby-2.7",
       "shortDescription": {
        "text": "Ruby 2.7 reached end of life on 2023-03-31"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "CWE-1104: Use of Unmaintained Third Party Components"
        ]
       }
      }
     ]
    }
   },
   "invocations": [
    {
     "executionSuccessful": true,
     "toolExecutionNotifications": []
    }
   ],
   "properties": {
    "snapshotFetched": "2026-10-11",
    "asOf": "2026-10-13",
    "undetermined": []
   },
   "results": [
    {
     "ruleId": "eol/ruby-2.7",
     "level": "warning",
     "message": {
      "text": ".ruby-version pins Ruby 2.7.6 (.ruby-version); Ruby 2.7 reached end of life on 2023-03-31, after which it receives no security fixes. Move to a supported release."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".ruby-version"
        },
        "region": {
         "startLine": 1
        }
       }
      }
     ]
    },
    {
     "ruleId": "eol/nodejs-16",
     "level": "warning",
     "message": {
      "text": "Dockerfile pins Node.js 16-alpine (Dockerfile FROM); Node.js 16 reached end of life on 2023-09-11, after which it receives no security fixes. Move to a supported release."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "Dockerfile"
        },
        "region": {
         "startLine": 1
        }
       }
      }
     ]
    },
    {
     "ruleId": "eol/postgresql-9.6",
     "level": "warning",
     "message": {
      "text": "db/docker-compose.yml pins PostgreSQL 9.6 (Compose image); PostgreSQL 9.6 reached end of life on 2021-11-11, after which it receives no security fixes. Move to a supported release."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "db/docker-compose.yml"
        },
        "region": {
         "startLine": 3
        }
       }
      }
     ]
    }
   ]
  }
 ]
}
