              "shortDescription": {
                "text": "GuardDog rule: metadata_mismatch"
              },
              "fullDescription": {
                "text": "Detects mismatches between a package's registry metadata and its actual manifest file.\n\n    This catches supply chain attacks where the registry metadata (dependencies, scripts,\n    entry points) differs from what's declared inside the package itself.\n    "
              },
              "help": {
                "text": "Detects mismatches between a package's registry metadata and its actual manifest file.\n\n    This catches supply chain attacks where the registry metadata (dependencies, scripts,\n    entry points) differs from what's declared inside the package itself.\n    ",
