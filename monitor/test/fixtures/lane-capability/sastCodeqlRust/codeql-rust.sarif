     "rules": [
      {
       "id": "rust/access-invalid-pointer",
       "name": "rust/access-invalid-pointer",
       "shortDescription": {
        "text": "Access of invalid pointer"
       },
       "fullDescription": {
        "text": "Dereferencing an invalid or dangling pointer causes undefined behavior and may result in memory corruption."
       },
       "defaultConfiguration": {
        "enabled": true,
        "level": "error"
       },
       "properties": {
        "tags": [
         "reliability",
         "security",
         "external/cwe/cwe-476",
         "external/cwe/cwe-825"
        ],
        "description": "Dereferencing an invalid or dangling pointer causes undefined behavior and may result in memory corruption.",
        "id": "rust/access-invalid-pointer",
        "kind": "path-problem",
        "name": "Access of invalid pointer",
        "precision": "high",
        "problem.severity": "error",
        "security-severity": "7.5"
       }
      },
      {
       "id": "rust/cleartext-logging",
       "name": "rust/cleartext-logging",
       "shortDescription": {
        "text": "Cleartext logging of sensitive information"
       },
       "fullDescription": {
        "text": "Logging sensitive information in plaintext can expose it to an attacker."
       },
       "defaultConfiguration": {
        "enabled": true,
        "level": "warning"
       },
       "properties": {
        "tags": [
         "security",
         "external/cwe/cwe-312",
         "external/cwe/cwe-359",
         "external/cwe/cwe-532"
        ],
        "description": "Logging sensitive information in plaintext can\n              expose it to an attacker.",
        "id": "rust/cleartext-logging",
        "kind": "path-problem",
        "name": "Cleartext logging of sensitive information",
        "precision": "high",
        "problem.severity": "warning",
        "security-severity": "7.5"
       }
      }
