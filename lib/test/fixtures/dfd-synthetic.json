{
  "v": 1,
  "kind": "dfd",
  "title": "Order analytics (synthetic fixture)",
  "source": {
    "producer": "authored",
    "note": "Hand-authored test fixture: every element kind, every subtype family, every flow role and every flow topology the visualiser supports, in one model. Elements after the analyst were added with the subtypes and roles; none before it was removed."
  },
  "layers": ["bronze", "silver", "gold"],
  "groups": [
    { "id": "internet", "label": "Internet", "boundary": "trust" },
    { "id": "platform", "label": "Order platform", "boundary": "system" }
  ],
  "nodes": [
    { "id": "customer", "kind": "external", "label": "Customer", "subtype": "actor", "group": "internet" },
    { "id": "api", "kind": "process", "label": "Order API", "group": "platform" },
    { "id": "orders-db", "kind": "store", "label": "Orders DB", "subtype": "database", "group": "platform" },
    { "id": "events", "kind": "store", "label": "order-events", "subtype": "topic", "group": "platform", "note": "Kafka topic" },
    { "id": "ingest", "kind": "process", "label": "Ingest", "layer": "bronze" },
    { "id": "bronze", "kind": "store", "label": "Raw orders", "subtype": "file", "layer": "bronze" },
    { "id": "transform", "kind": "process", "label": "Clean and conform", "layer": "silver" },
    { "id": "enrich", "kind": "process", "label": "Enrich", "layer": "silver" },
    { "id": "validate", "kind": "process", "label": "Validate quality", "layer": "silver" },
    { "id": "quarantine", "kind": "store", "label": "Quarantine", "subtype": "file", "layer": "silver" },
    { "id": "silver", "kind": "store", "label": "Conformed orders", "subtype": "file", "layer": "silver" },
    { "id": "aggregate", "kind": "process", "label": "Aggregate", "layer": "gold" },
    { "id": "features", "kind": "process", "label": "Build features", "layer": "gold" },
    { "id": "gold", "kind": "store", "label": "Gold marts", "subtype": "database", "layer": "gold" },
    { "id": "serve", "kind": "process", "label": "Report API" },
    { "id": "analyst", "kind": "external", "label": "BI analyst", "subtype": "actor" },
    { "id": "payments", "kind": "external", "label": "https://payments.example:443", "subtype": "endpoint" },
    { "id": "nightly", "kind": "external", "label": "cron: nightly rebuild", "subtype": "scheduler" },
    { "id": "db-url", "kind": "external", "label": "ORDERS_DB_URL", "subtype": "env" },
    { "id": "audit", "kind": "store", "label": "audit.log", "subtype": "log", "note": "appended by the API, tailed by alerting" },
    { "id": "alerting", "kind": "process", "label": "Alerting" },
    { "id": "pager", "kind": "external", "label": "Paging service", "subtype": "system" }
  ],
  "flows": [
    { "from": "customer", "to": "api", "label": "order request", "mode": "sync" },
    { "from": "api", "to": "customer", "label": "order status", "mode": "sync" },
    { "from": "api", "to": "orders-db", "label": "order row", "mode": "sync", "evidence": { "witness": "both", "existence": "confirmed", "refs": ["api/orders.mjs:41 insert"] } },
    { "from": "api", "to": "events", "label": "OrderPlaced", "mode": "async" },
    { "from": "events", "to": "ingest", "label": "OrderPlaced", "mode": "event" },
    { "from": "ingest", "to": "ingest", "label": "retry on timeout", "mode": "sync", "role": "retry" },
    { "from": "ingest", "to": "bronze", "label": "raw batch", "mode": "sync" },
    { "from": "bronze", "to": "transform", "label": "raw batch", "mode": "sync" },
    { "from": "transform", "to": "enrich", "label": "clean rows", "mode": "sync" },
    { "from": "enrich", "to": "validate", "label": "candidate rows", "mode": "sync" },
    { "from": "validate", "to": "transform", "label": "validation errors", "mode": "sync", "role": "error" },
    { "from": "validate", "to": "bronze", "label": "replay request", "mode": "async", "role": "retry", "evidence": { "witness": "authored", "existence": "unknown" } },
    { "from": "validate", "to": "quarantine", "label": "rejected rows", "mode": "sync" },
    { "from": "validate", "to": "silver", "label": "valid rows", "mode": "sync" },
    { "from": "silver", "to": "aggregate", "label": "orders", "mode": "sync" },
    { "from": "silver", "to": "features", "label": "orders", "mode": "sync" },
    { "from": "aggregate", "to": "gold", "label": "daily totals", "mode": "sync", "role": "data", "direction": "writes", "existence": "confirmed", "evidence": { "witness": "both", "existence": "confirmed", "refs": ["aggregate.mjs:12 touch, resolved by the runtime"] } },
    { "from": "features", "to": "gold", "label": "feature rows", "mode": "sync" },
    { "from": "gold", "to": "serve", "label": "marts", "mode": "sync" },
    { "from": "serve", "to": "analyst", "label": "report", "mode": "sync" },
    { "from": "api", "to": "payments", "label": "charge", "mode": "sync", "existence": "unknown" },
    { "from": "nightly", "to": "aggregate", "label": "triggers", "mode": "event" },
    { "from": "db-url", "to": "api", "label": "connection string", "mode": "sync" },
    { "from": "api", "to": "audit", "label": "appends", "mode": "async" },
    { "from": "audit", "to": "alerting", "label": "tails", "mode": "async" },
    { "from": "alerting", "to": "pager", "label": "alert", "mode": "sync" }
  ]
}
